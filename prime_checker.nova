fn is_prime(n) {
    if (n <= 1) {
        return 0;
    }
    var i = 2;
    while (i * i <= n) {
        if (n - (n / i) * i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

var check_num = 13;
if (is_prime(check_num)) {
    print(check_num + " is a Prime Number!");
} else {
    print(check_num + " is NOT a Prime Number.");
}
